---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site.mjs";
---

<BaseLayout
  title={`Search · ${site.title}`}
  description="Search the site."
>
  <main class="flex flex-col w-full max-w-4xl px-4 pb-12 lg:px-6" data-pagefind-ignore>
    <header class="mb-8 border-b border-text/15 pb-6">
      <p class="mb-2 font-mono text-xs uppercase tracking-[0.16em] text-highlight">Find something</p>
      <h1 class="m-0 text-3xl font-bold text-white lg:text-4xl">Search the garden</h1>
      <p class="mt-3 mb-0 max-w-2xl text-sm leading-relaxed text-text/65">
        Search notes, media, reading lists, and everything else I have collected here.
        Press <kbd>⌘K</kbd> or <kbd>Ctrl K</kbd> from anywhere.
      </p>
    </header>
    <div id="pagefind-ui-page" class="pagefind-shell" data-pagefind-ui></div>
    <noscript>
      <p class="text-sm text-text/70">JavaScript is required for search.</p>
    </noscript>
  </main>
</BaseLayout>

<script>
  const pagefindCss = "/pagefind/pagefind-ui.css";
  const pagefindJs = "/pagefind/pagefind-ui.js";

  function init() {
    const root = document.getElementById("pagefind-ui-page");
    if (!root) return;

    (async () => {
      try {
        if (!document.querySelector(`link[href$="${pagefindCss}"]`)) {
          const link = document.createElement("link");
          link.rel = "stylesheet";
          link.href = pagefindCss;
          document.head.appendChild(link);
        }
        if (!window.PagefindUI) {
          await import(/* @vite-ignore */ pagefindJs);
        }
        new window.PagefindUI({
          element: root,
          showImages: false,
          showSubResults: false,
          resetStyles: true,
          autofocus: true,
          excerptLength: 24,
          translations: {
            placeholder: "Search notes, tags, and topics…",
            search_label: "Search the garden",
            input_hint: "Results appear as you type",
          },
        });
      } catch (error) {
        console.error("Pagefind UI failed to load", error);
        root.innerHTML =
          '<p style="padding: 1rem; color: #888; font-size: 0.875rem;">Search is not available in dev mode. Run <code>bun build</code> and serve <code>apps/v2/dist</code> to use search.</p>';
      }
    })();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
