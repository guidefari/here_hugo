---
import { getEntriesBySection } from "../../../lib/content.mjs";
import ProjectSingle from "../../../components/ProjectSingle.astro";

export async function getStaticPaths() {
  const projects = await getEntriesBySection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<ProjectSingle project={project} />
