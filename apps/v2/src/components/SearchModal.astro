---
---

<dialog id="search-modal" aria-labelledby="search-modal-title" class="search-modal" closedby="any" data-pagefind-ignore>
  <header class="search-modal__header">
    <div>
      <p class="search-modal__eyebrow">Quick find</p>
      <h2 id="search-modal-title">Search the garden</h2>
    </div>
    <form method="dialog">
      <button class="search-modal__close" type="submit" aria-label="Close search">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" />
        </svg>
      </button>
    </form>
  </header>
  <div id="pagefind-ui-root" class="pagefind-shell" data-pagefind-ui></div>
  <footer class="search-modal__footer">
    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
    <span><kbd>Esc</kbd> close</span>
    <a href="/search/">Full search page <span aria-hidden="true">→</span></a>
  </footer>
  <noscript>
    <p class="p-4 text-sm">JavaScript is required for search.</p>
  </noscript>
</dialog>

<style>
  .search-modal {
    width: min(calc(100vw - 2rem), 760px);
    max-width: 760px;
    max-height: min(88dvh, 760px);
    margin: max(1rem, 5dvh) auto;
    padding: 0;
    overflow: hidden;
    color: var(--color-text);
    background: color-mix(in oklab, var(--color-bg) 92%, black);
    border: 1px solid color-mix(in oklab, var(--color-highlight) 45%, transparent);
    border-radius: 3px;
    box-shadow: 8px 8px 0 color-mix(in oklab, black 45%, transparent);
  }

  .search-modal[open] {
    display: flex;
    flex-direction: column;
  }

  .search-modal::backdrop {
    background: color-mix(in oklab, #071014 78%, transparent);
    backdrop-filter: blur(5px);
  }

  .search-modal__header,
  .search-modal__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .search-modal__header {
    flex: none;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid color-mix(in oklab, var(--color-text) 14%, transparent);
  }

  .search-modal__eyebrow {
    margin: 0 0 0.15rem;
    color: var(--color-highlight);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .search-modal h2 {
    margin: 0;
    color: white;
    font-size: 1rem;
    line-height: 1.3;
  }

  .search-modal__close {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    place-items: center;
    color: var(--color-text);
    background: transparent;
    border: 1px solid color-mix(in oklab, var(--color-text) 25%, transparent);
    border-radius: 2px;
    cursor: pointer;
  }

  .search-modal__close:hover,
  .search-modal__close:focus-visible {
    color: #000;
    background: var(--color-highlight);
    border-color: var(--color-highlight);
    outline: none;
  }

  #pagefind-ui-root {
    min-height: 5rem;
    padding: 1.25rem;
    overflow-y: auto;
  }

  .search-modal__footer {
    flex: none;
    padding: 0.75rem 1.25rem;
    color: color-mix(in oklab, var(--color-text) 62%, transparent);
    border-top: 1px solid color-mix(in oklab, var(--color-text) 14%, transparent);
    font-size: 0.68rem;
  }

  .search-modal__footer span {
    white-space: nowrap;
  }

  .search-modal__footer kbd {
    margin-inline-end: 0.25rem;
    padding: 0.05rem 0.3rem;
    color: var(--color-text);
    border: 1px solid color-mix(in oklab, var(--color-text) 22%, transparent);
    border-radius: 2px;
  }

  .search-modal__footer a {
    margin-inline-start: auto;
    color: var(--color-highlight);
    text-decoration: none;
  }

  @media (max-width: 520px) {
    .search-modal {
      width: calc(100vw - 1rem);
      max-height: calc(100dvh - 1rem);
      margin: 0.5rem auto;
      box-shadow: 4px 4px 0 color-mix(in oklab, black 45%, transparent);
    }

    .search-modal__header,
    #pagefind-ui-root,
    .search-modal__footer {
      padding-inline: 1rem;
    }

    .search-modal__footer > span {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-modal::backdrop {
      backdrop-filter: none;
    }
  }
</style>

<script>
  const dialogId = "search-modal";
  const rootId = "pagefind-ui-root";
  const pagefindCss = "/pagefind/pagefind-ui.css";
  const pagefindJs = "/pagefind/pagefind-ui.js";

  function init() {
    const dialog = document.getElementById(dialogId);
    const root = document.getElementById(rootId);
    if (!dialog || !root) return;

    let pagefindUI = null;
    let initializing = null;

    function ensurePagefind() {
      if (pagefindUI) return pagefindUI;
      if (initializing) return initializing;
      initializing = (async () => {
        try {
          if (!document.querySelector(`link[href$="${pagefindCss}"]`)) {
            const link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = pagefindCss;
            document.head.appendChild(link);
          }
          if (!window.PagefindUI) {
            await import(/* @vite-ignore */ pagefindJs);
          }
          pagefindUI = new window.PagefindUI({
            element: root,
            showImages: false,
            showSubResults: false,
            resetStyles: true,
            autofocus: true,
            excerptLength: 20,
            translations: {
              placeholder: "Search notes, tags, and topics…",
              search_label: "Search the garden",
              input_hint: "Results appear as you type",
            },
          });
        } catch (error) {
          console.error("Pagefind UI failed to load", error);
          if (root) {
            root.innerHTML =
              '<p style="padding: 1rem; color: #888; font-size: 0.875rem;">Search is not available in dev mode. Run <code>bun build</code> and serve <code>apps/v2/dist</code> to use search.</p>';
          }
        }
        return pagefindUI;
      })();
      return initializing;
    }

    function open() {
      if (typeof dialog.showModal === "function") dialog.showModal();
      ensurePagefind();
    }

    function close() {
      if (dialog.open) dialog.close();
    }

    document.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        if (dialog.open) close();
        else open();
        return;
      }
      if (event.key === "Escape" && dialog.open) {
        close();
      }
    });

    document.addEventListener("click", (event) => {
      const trigger = event.target instanceof Element
        ? event.target.closest("[data-search-toggle]")
        : null;
      if (trigger) {
        event.preventDefault();
        open();
        return;
      }
      if (event.target === dialog) close();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init);
  } else {
    init();
  }
</script>
