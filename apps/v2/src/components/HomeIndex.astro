---
import { getAllEntries, formatDate } from "../lib/content.mjs";
import { writingSections, homeWritingSections, elsewhereLinks } from "../lib/site.mjs";

const entries = await getAllEntries();
const writing = entries.filter((entry) => writingSections.includes(entry.section));
const featured = writing.filter((entry) => entry.data.featured).slice(0, 3);
const featuredPermalinks = new Set(featured.map((entry) => entry.permalink));
const recent = entries
  .filter(
    (entry) =>
      (homeWritingSections.includes(entry.section) || entry.section === "media") &&
      !entry.draft &&
      !featuredPermalinks.has(entry.permalink)
  )
  .slice(0, 6);

---

<div class="home-index max-w-7xl pt-2 lg:pt-10 flex flex-col gap-12 font-mono">
  <section>
    <h2 class="m-0 mb-4 text-xs font-normal text-text/40">featured</h2>
    <ul class="m-0 p-0 flex flex-col gap-3">
      {featured.map((entry) => (
        <li class="list-none">
          <a href={entry.permalink} class="group flex items-baseline gap-3 no-underline">
            <span class="post-link text-base font-bold text-highlight group-hover:text-white transition-colors">{entry.title}</span>
            <span class="grow border-b border-dotted border-text/20 translate-y-[-3px]"></span>
            {entry.date && <span class="shrink-0 text-xs text-text/40">{formatDate(entry.date, { month: "short", year: "numeric" })}</span>}
            {entry.draft && <span class="text-red-400 text-xs">DRAFT</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="m-0 mb-4 text-xs font-normal text-text/40">recent</h2>
    <ul class="m-0 p-0 flex flex-col gap-3">
      {recent.map((entry) => (
        <li class="list-none">
          <a href={entry.permalink} class="group flex items-baseline gap-3 no-underline">
            <span class="post-link text-sm text-text/85 group-hover:text-highlight transition-colors">{entry.title}</span>
            <span class="grow border-b border-dotted border-text/15 translate-y-[-3px]"></span>
            <span class="shrink-0 text-xs text-text/40">
              {entry.section === "media" ? "media" : entry.section}
              {entry.date && <>&nbsp;&middot;&nbsp;{formatDate(entry.date, { month: "short", day: "numeric" })}</>}
            </span>
            {entry.draft && <span class="text-red-400 text-xs">DRAFT</span>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2 class="m-0 mb-1 text-xs font-normal text-text/40">elsewhere</h2>
    <p class="m-0 mb-4 text-xs text-text/40">things I make outside this site</p>
    <ul class="m-0 p-0 flex flex-col gap-3">
      {elsewhereLinks.map((link) => (
        <li class="list-none">
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="group flex items-baseline gap-3 no-underline">
            <span class="text-sm text-highlight group-hover:text-white transition-colors">&rarr; {link.label}</span>
            <span class="grow border-b border-dotted border-text/15 translate-y-[-3px]"></span>
            <span class="shrink-0 text-xs text-text/40">{link.blurb} &#8599;</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .home-index {
    min-height: calc(100dvh - 6rem);
  }

  .home-index > section {
    max-width: 62rem;
  }

  .home-index > section + section {
    padding-top: 0.25rem;
  }
</style>
