---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCanonicalUrl, getEntriesBySection, getSectionInfo } from "../lib/content.mjs";
import { getSeries } from "../lib/series.mjs";
import YearGroupedList from "./YearGroupedList.astro";

const { section } = Astro.props;
const info = await getSectionInfo(section);
const entries = await getEntriesBySection(section);
const visibleEntries = [];

for (const entry of entries) {
  const seriesId = entry.data?.series;
  if (!seriesId) {
    visibleEntries.push(entry);
    continue;
  }

  const series = await getSeries(seriesId);
  if (!series?.hub || series.hub.permalink === entry.permalink) {
    visibleEntries.push(entry);
  }
}

const path = `/${section}/`;
---

<BaseLayout title={info.title} description={info.description} canonical={getCanonicalUrl(path)}>
  <main class="flex flex-col mx-auto w-full max-w-5xl px-4 lg:px-6 py-8">
    <div class="mb-8">
      <h1 class="text-5xl text-white m-0">{info.title}</h1>
      {info.description && <p class="max-w-2xl mt-4 text-text/75">{info.description}</p>}
    </div>

    <YearGroupedList entries={visibleEntries} listId={`section-${section}-list`} showSection={false} />
  </main>
</BaseLayout>
