---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCanonicalUrl } from "../lib/content.mjs";

const { project } = Astro.props;
const { Content } = await render(project._entry);
const { github, website, topics = [] } = project.data;
---

<BaseLayout
  title={project.title}
  description={project.description}
  canonical={getCanonicalUrl(`/projects/${project.slug}/`)}
>
  <main class="flex flex-col mx-auto w-full max-w-3xl px-4 lg:px-6 py-8">
    <div class="mb-6">
      <a href="/projects/" class="text-xs text-text/70 hover:text-highlight transition-colors">&larr; projects</a>
    </div>

    <header class="mb-8">
      <h1 class="text-4xl font-bold text-white m-0 mb-2">{project.title}</h1>
      <p class="text-base text-text/60 m-0">{project.description}</p>

      <div class="flex items-center gap-3 mt-4">
        {github && (
          <a href={github} class="inline-flex items-center gap-1.5 text-xs text-text/50 hover:text-highlight transition-colors" target="_blank" rel="noopener noreferrer">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
            source
          </a>
        )}
        {website && (
          <a href={website} class="inline-flex items-center gap-1.5 text-xs text-text/50 hover:text-highlight transition-colors" target="_blank" rel="noopener noreferrer">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            site
          </a>
        )}
      </div>
    </header>

    {topics.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {topics.map((topic) => (
          <span class="text-[10px] font-mono tracking-wider text-highlight/70 bg-highlight/10 px-2 py-0.5 rounded-sm">{topic}</span>
        ))}
      </div>
    )}

    <article class="prose lg:prose-xl max-w-none prose-pre:overflow-x-auto prose-pre:max-w-full [&_h2]:text-2xl [&_h2]:lg:text-4xl [&_h3]:text-xl [&_h3]:lg:text-3xl">
      <Content />
    </article>
  </main>
</BaseLayout>
