<script>
  const playground = document.querySelector("[data-gpu-playground]");
  if (playground) {
    const status = playground.querySelector("[data-gpu-status]");
    const load = async () => {
      status.textContent = "Loading examples…";
      try {
        const { start } = await import("../lib/gpu-examples/playground.js");
        playground.querySelector("[data-gpu-content]").hidden = false;
        await start(playground);
        status.textContent = "";
      } catch {
        status.textContent = "Could not load the examples.";
      }
    };

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void load();
      }, { rootMargin: "200px" });
      observer.observe(playground);
    } else {
      void load();
    }
  }
</script>

