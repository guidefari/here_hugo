---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/reports";

interface Props {
  report: CollectionEntry<"reports">;
}

const { report } = Astro.props;
---

<article class="report-card">
  <p class="eyebrow"><time datetime={report.data.date.toISOString()}>{formatDate(report.data.date)}</time> · Agent-generated</p>
  <h2><a href={`/reports/${report.id}/`}>{report.data.title}</a></h2>
  <p>{report.data.description}</p>
  {report.data.tags.length > 0 && (
    <ul class="tags" aria-label="Topics">
      {report.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  )}
</article>
