---
import type { CollectionEntry } from "astro:content";

interface Props {
  notes: CollectionEntry<"reports">[];
}

const { notes } = Astro.props;
---

{notes.length > 0 && (
  <details class="supporting-notes">
    <summary>Supporting research ({notes.length} notes)</summary>
    <ul>
      {notes.map((note) => <li><a href={`/reports/${note.id}/`}>{note.data.title}</a></li>)}
    </ul>
  </details>
)}
