---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SupportingNotes from "../../components/SupportingNotes.astro";
import { formatDate, publishedReports } from "../../lib/reports";

export async function getStaticPaths() {
  return (await publishedReports()).map((report) => ({
    params: { id: report.id },
    props: { report },
  }));
}

interface Props {
  report: CollectionEntry<"reports">;
}

const { report } = Astro.props;
const { Content, headings } = await render(report);
const sections = headings.filter((heading) => heading.depth === 2);
const reports = await publishedReports();
const parent = reports.find((entry) => entry.id === report.data.parent);
const supporting = reports
  .filter((entry) => entry.data.parent === report.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout title={report.data.title} description={report.data.description}>
  <article>
    <header class="report-header">
      <a href="/">← Research library</a>
      {parent && <p><a href={`/reports/${parent.id}/`}>Part of: {parent.data.title}</a></p>}
      <p class="eyebrow">Agent-generated research · <time datetime={report.data.date.toISOString()}>{formatDate(report.data.date)}</time></p>
      <h1>{report.data.title}</h1>
      <p class="lede">{report.data.description}</p>
      {report.data.updated && <p>Updated <time datetime={report.data.updated.toISOString()}>{formatDate(report.data.updated)}</time></p>}
      {report.data.tags.length > 0 && (
        <ul class="tags" aria-label="Topics">
          {report.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
      <p class="notice">Generated with AI assistance. Claims may be incomplete or out of date. Check the linked sources before relying on them.</p>
    </header>
    {sections.length > 0 && (
      <nav class="contents" aria-label="On this page">
        <h2>On this page</h2>
        <ol>
          {sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
        </ol>
      </nav>
    )}
    <div class="prose"><Content /></div>
    <SupportingNotes notes={supporting} />
  </article>
</BaseLayout>
