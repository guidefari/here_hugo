---
import BaseLayout from "../layouts/BaseLayout.astro";
import ReportCard from "../components/ReportCard.astro";
import { libraryReports } from "../lib/reports";

const reports = await libraryReports();
---

<BaseLayout title="Research library" description="A reading room for agent-generated research: evidence, source notes, and open questions collected by Guide Fari.">
  <section class="intro">
    <p class="eyebrow">The research shelf</p>
    <h1>A place to read the research.</h1>
    <p class="lede">Evidence, source notes, and open questions from my agents. Kept separate from the articles I write myself.</p>
  </section>
  <section aria-labelledby="reports-heading">
    <div class="section-heading">
      <h2 id="reports-heading">Research library</h2>
      <span>{reports.length} {reports.length === 1 ? "report" : "reports"}</span>
    </div>
    {reports.map((report) => <ReportCard report={report} />)}
    {reports.length === 0 && (
      <div class="empty-state">
        <h3>The shelves are ready.</h3>
        <p>The first reports are being selected. Published research will appear here with its sources and research date.</p>
      </div>
    )}
  </section>
</BaseLayout>
