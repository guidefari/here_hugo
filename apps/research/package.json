{
  "name": "@here/research",
  "private": true,
  "type": "module",
  "scripts": {
    "content:build": "bun run scripts/build-content.ts",
    "dev": "bun run content:build && vite",
    "build": "bun run --cwd ../../packages/theme build:css && bun run content:build && vite build",
    "preview": "vite preview --port 1415",
    "typecheck": "bun run content:build && bun check",
    "test": "bun run content:build && vitest run",
    "verify": "bun run test && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.18",
    "@here/theme": "workspace:*",
    "effect": "4.0.0-rc.116",
    "foldkit": "^0.163.0"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@foldkit/devtools": "^0.163.0",
    "@foldkit/vite-plugin": "^0.24.0",
    "@types/bun": "1.4.2",
    "happy-dom": "^20.10.4",
    "shiki": "4.2.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
