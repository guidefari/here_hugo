{
  "name": "here_hugo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "- [ ] 404 page",
  "main": "index.js",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "cd apps/v2 && bun run build",
    "content:new": "bun run apps/content-cli/src/main.ts",
    "content:check": "bun x tsc --project apps/content-cli/tsconfig.json",
    "content:test": "bun x vitest run apps/content-cli/src",
    "build:v2": "cd apps/v2 && bun run build",
    "build:og": "bun run --cwd apps/og-image build",
    "dev": "cd apps/v2 && bun run dev",
    "dev:v2": "cd apps/v2 && bun run dev",
    "dev:cloud": "bun run build:og && alchemy dev",
    "deploy": "bun run build:og && alchemy deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guidefari/here_hugo.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/guidefari/here_hugo/issues"
  },
  "homepage": "https://github.com/guidefari/here_hugo#readme",
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.107",
    "@effect/platform-node": "4.0.0-beta.107",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.107",
    "@types/bun": "1.3.14",
    "vitest": "4.1.0"
  }
}
